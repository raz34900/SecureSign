# Copy to .env and fill. NEVER commit .env.
# Generate any key/password below with: openssl rand -hex 32
POSTGRES_PASSWORD=
SS_DATABASE_URL=postgresql+psycopg://securesign:${POSTGRES_PASSWORD}@db:5432/securesign
SS_MODEL_PATH=models/secure_sign_epoch_50_loss_0.2009_acc_83.48.pth
SS_MODEL_VERSION=custom_cnn_v1
SS_THRESHOLD=0.3999
# 32-byte hex keys. Losing SS_PII_ENC_KEY loses every national id and signature image.
SS_PII_ENC_KEY=
SS_PII_INDEX_KEY=
# Encrypts the pgBackRest repository - a third key; losing it loses every backup.
BACKUP_REPO_PASSPHRASE=
SS_SESSION_TTL_HOURS=12
SS_MAX_UPLOAD_MB=10
# Demo fixtures only (scripts/seed_demo.py); leave empty on a real installation.
SS_SEED_CLERK_PASSWORD=
SS_SEED_VERIFIER_PASSWORD=
SS_SEED_ENGINEER_PASSWORD=
SS_SEED_ORG_ADMIN_PASSWORD=
SS_BOOTSTRAP_PASSWORD=
